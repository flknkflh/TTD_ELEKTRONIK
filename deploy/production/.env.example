# deploy/production/.env — NEVER commit this file (.env is git-ignored).
#
#   cp .env.example .env && chmod 600 .env
#   sed -i "s|^PQC_JWT_SECRET=.*|PQC_JWT_SECRET=$(openssl rand -hex 32)|" .env
#   sed -i "s|^PQC_DB_PASSWORD=.*|PQC_DB_PASSWORD=$(openssl rand -hex 24)|" .env
#
# Comments stay on their own lines: compose reads everything after "=".

# Public domain. QR codes encode https://<this>/v/<id> for years — pick the
# final name before the first document is signed.
PQC_DOMAIN=pqsign.example.go.id

# Let's Encrypt account e-mail (expiry / problem notices).
ACME_EMAIL=admin@example.go.id

# Session-token signing key. Generate, never reuse the lab value.
PQC_JWT_SECRET=

# PostgreSQL password. Generate, never reuse the lab value.
PQC_DB_PASSWORD=

# First super-admin login name. Its password is generated on first boot and
# printed once in `docker compose logs api`.
PQC_SUPERADMIN_USERNAME=superadmin

# Document size caps in MB. The PDF libraries parse whole files in memory and
# refuse more than 64 MB, so larger values only add store-only uploads.
PQC_MAX_UPLOAD_MB=64
PQC_MAX_STAMP_MB=64
PQC_MAX_VERIFY_MB=64

# Caddy request-body cap. Keep it at PQC_MAX_UPLOAD_MB + 8.
PQC_PROXY_MAX_BODY_MB=72

# API container limits (a crafted PDF can spin a CPU core, see SF-1).
PQC_API_MEM_LIMIT=2g
PQC_API_CPUS=2
