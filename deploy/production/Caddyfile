# PQ PDF Sign — public entry point (deploy/production/RUNBOOK.md).
#
# Caddy obtains and renews the Let's Encrypt certificate for {$PQC_DOMAIN} on
# its own, redirects http -> https, and negotiates TLS 1.3 with the hybrid
# post-quantum X25519MLKEM768 key exchange by default (classic X25519 for old
# clients). This TLS certificate is unrelated to the PDF-signing Root CA.

{
	email {$ACME_EMAIL}
}

{$PQC_DOMAIN} {
	encode zstd gzip

	# Must be >= PQC_MAX_UPLOAD_MB plus multipart overhead (.env keeps +8).
	request_body {
		max_size {$PQC_PROXY_MAX_BODY_MB}MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	log {
		output file /data/access.log {
			roll_size 50MiB
			roll_keep 10
		}
	}

	route {
		# Optional: admin console reachable only from the office network.
		# Uncomment and put the real addresses (RUNBOOK section 5.4).
		# @adminOutside {
		# 	path /admin /admin/* /api/v1/admin/*
		# 	not remote_ip 203.0.113.10/32
		# }
		# respond @adminOutside 403

		# "/" is the verification home page, served only by the verify site.
		@verifyHome path /
		reverse_proxy @verifyHome api:8098

		# Everything else: QR pages (/v, /s), public verify API, apps, /admin.
		reverse_proxy api:8099
	}
}
