# /etc/pqsign-backup.env — settings for pqsign-backup (RUNBOOK §8.1).
# Values below are for the production stack (compose project "pqsign").
# The lab stack (deploy/local, project "pqc-pdf-sign") uses:
#   PQSIGN_PG_CONTAINER=pqc-pdf-sign-postgres-1
#   PQSIGN_VOLUMES="pqc-pdf-sign_objdata pqc-pdf-sign_cadata"

PQSIGN_PG_CONTAINER=pqsign-postgres-1
PQSIGN_PG_USER=pqc
PQSIGN_PG_DB=pqc
PQSIGN_VOLUMES="pqsign_objdata pqsign_cadata"

PQSIGN_BACKUP_ROOT=/var/backups/pqsign
PQSIGN_RESTIC_PASSWORD_FILE=/root/.config/pqsign-backup/restic-password

# Shown in the super admin report; keep it in step with pqsign-backup.cron.
PQSIGN_BACKUP_SCHEDULE_TEXT="setiap hari 02:30 UTC"

PQSIGN_KEEP_DAILY=7
PQSIGN_KEEP_WEEKLY=4
PQSIGN_KEEP_MONTHLY=6
