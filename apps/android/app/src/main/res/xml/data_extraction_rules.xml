<?xml version="1.0" encoding="utf-8"?>
<!-- Exclude everything from cloud backup / device transfer. The device key
     (once M5 adds real key storage) must never leave the device this way
     (Rencana V1 §12.2, §26). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
